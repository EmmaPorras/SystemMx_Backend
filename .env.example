NODE_ENV=development
PORT=3000

JWT_SECRET=
JWT_EXPIRES_SECONDS=3600

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Neon PostgreSQL
# DATABASE_URL: pooled connection for normal application traffic.
# DATABASE_URL_UNPOOLED: direct connection for TypeORM migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DB_LOGGING=true

# Credenciales para el script de bootstrap inicial de administrador
SYSTEMMX_BOOTSTRAP_USERNAME=
SYSTEMMX_BOOTSTRAP_NOMBRE=
SYSTEMMX_BOOTSTRAP_PASSWORD=
